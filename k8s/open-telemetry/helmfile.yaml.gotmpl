repositories:
  - name: opentelemetry-helm
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
templates:
  default-release: &default-release
    namespace: opentelemetry-kube-stack
    # namespace: opentelemetry-operator-system
environments:
  default:
    values:
      - releases:
          opentelemetry-operator:
            version: 0.112.1
            <<: *default-release
          opentelemetry-kube-stack:
            version: 0.14.12
            <<: *default-release
---
templates:
  default: &default
    version: '{{`{{ .Values | get "releases" | get .Release.Name | get "version" }}`}}'
    namespace: '{{`{{ .Values | get "releases" | get .Release.Name | get "namespace" }}`}}'
    values:
      - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
releases:
  - chart: opentelemetry-helm/opentelemetry-operator
    name: opentelemetry-operator
    <<: *default
  - chart: opentelemetry-helm/opentelemetry-kube-stack
    name: opentelemetry-kube-stack
    <<: *default
    set:
      - name: opentelemetry-operator.enabled
        value: false
      - name: opentelemetry-operator.crds.create
        value: false
