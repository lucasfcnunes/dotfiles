# otelCollectorEndpoint: http://signoz-otel-collector:4318
otelCollectorEndpoint: http://signoz-otel-collector.{{ .Release.Namespace }}.svc.cluster.local:4318
otelInsecure: true
insecureSkipVerify: true
presets:
  otlphttpExporter:
    enabled: true
  otlpExporter:
    enabled: false
  # debugExporter:
  #   enabled: true
  #   verbosity: basic
  #   samplingInitial: 2
  #   samplingThereafter: 500
