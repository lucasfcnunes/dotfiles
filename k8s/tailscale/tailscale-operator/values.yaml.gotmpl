extraObjects:
  resources:
    - apiVersion: tailscale.com/v1alpha1
      kind: ProxyGroup
      metadata:
        name: ingress-proxies
      spec:
        type: ingress
        replicas: 1
installCRDs: true
operatorConfig:
  defaultTags:
    - tag:k8s-operator
ingressClass:
  name: tailscale
  enabled: true
proxyConfig:
  defaultTags: tag:k8s
  firewallMode: auto
  # defaultProxyClass:
